# ---- LLM ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=text-embedding-3-small

# OCR fallback for scanned/image-only PDF pages (app/documents.py). Uses
# OPENAI_MODEL itself (gpt-4o, vision-capable) via app/llm.py's
# transcribe_image — no separate OCR provider/model to configure.
OCR_MAX_OUTPUT_TOKENS=2000
OCR_TIMEOUT_SECONDS=60.0
OCR_MAX_PAGES=30

# ---- Qdrant Cloud ----
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=...
QDRANT_COLLECTION=products

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key — server side only, never expose to a client
SUPABASE_SERVICE_KEY=...

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# chat id that receives lead + handoff alerts (your own chat or a group)
OPS_CHAT_ID=123456789
# random string; set as Telegram's secret_token and verified on each webhook
TELEGRAM_WEBHOOK_SECRET=change-me

# ---- WhatsApp Business Cloud API ----
# WhatsAppAdapter is a documented stub (app/channels.py) until the client
# hands over these. Leave blank until then — the adapter simply stays
# unreachable, nothing else depends on these being set.
# Permanent token from a System User in Meta Business Manager (not the
# 24-hour test token from the App Dashboard quickstart).
WHATSAPP_ACCESS_TOKEN=
# Settings > WhatsApp > API Setup, "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Dashboard > Settings > Basic, "App Secret" — HMAC-verifies
# X-Hub-Signature-256 on every inbound webhook. Meta docs treat this as
# mandatory, unlike Telegram's plain secret-token header.
WHATSAPP_APP_SECRET=
# Any string you choose; enter the SAME value in the Meta webhook config —
# echoed back as hub.verify_token on the one-time GET verification request.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0

# ---- WhatsApp via the existing portal (the path actually in use) ----
# Outbound goes through whatsapp-portal's own API, never Meta directly, so the
# portal stays the single writer of its Supabase (its inbox and delivery-status
# matching depend on it). Inbound arrives at /webhooks/whatsapp-inbound,
# forwarded by app_scripts/app.gs — which remains Meta's registered webhook.
WHATSAPP_PORTAL_BASE_URL=https://whatsapp-portal-divine.vercel.app
WHATSAPP_PORTAL_TIMEOUT_SECONDS=20.0
# Shared secret for the inbound forward. Set the SAME value in the Apps Script
# under Script Properties -> SALES_AGENT_SECRET. Empty = endpoint unauthenticated.
WHATSAPP_INBOUND_SECRET=
# Master switch. false = the endpoint acks but never runs the agent or sends
# anything, so this can deploy dark and be turned on deliberately.
WHATSAPP_AGENT_ENABLED=false

# ---- Redis (optional — .claude/Addition.md) ----
# Never the system of record; Supabase stays canonical. Every feature below is
# safe to leave disabled — the agent works identically either way. Phase A
# only wires the client and readiness check (see /ready); nothing reads or
# writes through Redis until its own phase's flag is turned on.
REDIS_URL=
REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_READ_TIMEOUT_SECONDS=1.0
REDIS_MAX_CONNECTIONS=20
# Per-feature flags, one per phase — enable one at a time in production.
REDIS_DEDUPE_ENABLED=false
REDIS_LOCKS_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
REDIS_JOBS_ENABLED=false
REDIS_CACHE_ENABLED=false
# Phase C only — per-conversation lock lease and bounded acquisition wait.
REDIS_LOCK_LEASE_SECONDS=30.0
REDIS_LOCK_WAIT_SECONDS=5.0
REDIS_LOCK_RETRY_INTERVAL_SECONDS=0.1
# Phase D only — rate limiting (Addition.md §4 initial policy table).
RATE_LIMIT_CUSTOMER_PER_MINUTE=10
RATE_LIMIT_CUSTOMER_BURST_PER_5MIN=30
RATE_LIMIT_DASHBOARD_PER_MINUTE=120
# Phase E only — durable post-reply jobs (Redis Streams). Requires a second
# Render service running `uv run python -m app.worker`; the web dyno only
# enqueues, it never consumes.
JOBS_CONSUMER_GROUP=intelligence-workers
JOBS_CONSUMER_NAME=
JOBS_CLAIM_IDLE_SECONDS=60.0
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_SECONDS=2.0
JOBS_BLOCK_MS=5000
JOBS_BATCH_SIZE=10
# Phase F only — exact hot-read caching (cache-aside, Redis -> source -> Redis).
CACHE_CUSTOMER_TTL_SECONDS=300
CACHE_SUMMARY_TTL_SECONDS=1800
CACHE_MACHINE_TTL_SECONDS=2400
CACHE_RAG_TTL_SECONDS=1200
CACHE_DASHBOARD_TTL_SECONDS=45
CACHE_STAMPEDE_LOCK_TTL_SECONDS=5.0
CACHE_STAMPEDE_WAIT_SECONDS=2.0

# ---- Runtime ----
PORT=10000
LOG_LEVEL=INFO
# set automatically by Render; used by /admin/telegram/set-webhook
RENDER_EXTERNAL_URL=
