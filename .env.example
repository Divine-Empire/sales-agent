# ---- LLM ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=text-embedding-3-small

# ---- Qdrant Cloud ----
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=...
QDRANT_COLLECTION=products

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key — server side only, never expose to a client
SUPABASE_SERVICE_KEY=...

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# chat id that receives lead + handoff alerts (your own chat or a group)
OPS_CHAT_ID=123456789
# random string; set as Telegram's secret_token and verified on each webhook
TELEGRAM_WEBHOOK_SECRET=change-me

# ---- WhatsApp Business Cloud API ----
# WhatsAppAdapter is a documented stub (app/channels.py) until the client
# hands over these. Leave blank until then — the adapter simply stays
# unreachable, nothing else depends on these being set.
# Permanent token from a System User in Meta Business Manager (not the
# 24-hour test token from the App Dashboard quickstart).
WHATSAPP_ACCESS_TOKEN=
# Settings > WhatsApp > API Setup, "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Dashboard > Settings > Basic, "App Secret" — HMAC-verifies
# X-Hub-Signature-256 on every inbound webhook. Meta docs treat this as
# mandatory, unlike Telegram's plain secret-token header.
WHATSAPP_APP_SECRET=
# Any string you choose; enter the SAME value in the Meta webhook config —
# echoed back as hub.verify_token on the one-time GET verification request.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0

# ---- Redis (optional — .claude/Addition.md) ----
# Never the system of record; Supabase stays canonical. Every feature below is
# safe to leave disabled — the agent works identically either way. Phase A
# only wires the client and readiness check (see /ready); nothing reads or
# writes through Redis until its own phase's flag is turned on.
REDIS_URL=
REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_READ_TIMEOUT_SECONDS=1.0
REDIS_MAX_CONNECTIONS=20
# Per-feature flags, one per phase — enable one at a time in production.
REDIS_DEDUPE_ENABLED=false
REDIS_LOCKS_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
REDIS_JOBS_ENABLED=false
REDIS_CACHE_ENABLED=false
# Phase C only — per-conversation lock lease and bounded acquisition wait.
REDIS_LOCK_LEASE_SECONDS=30.0
REDIS_LOCK_WAIT_SECONDS=5.0
REDIS_LOCK_RETRY_INTERVAL_SECONDS=0.1
# Phase D only — rate limiting (Addition.md §4 initial policy table).
RATE_LIMIT_CUSTOMER_PER_MINUTE=10
RATE_LIMIT_CUSTOMER_BURST_PER_5MIN=30
RATE_LIMIT_DASHBOARD_PER_MINUTE=120

# ---- Runtime ----
PORT=10000
LOG_LEVEL=INFO
# set automatically by Render; used by /admin/telegram/set-webhook
RENDER_EXTERNAL_URL=
